# Optional PubMed key. The workflow still works without one, but a key raises NCBI rate limits.
PUBMED_API_KEY=

# Standalone script settings. These are used when running without n8n.
DIGEST_OUTPUT_DIR=./out
DIGEST_LOOKBACK_DAYS=1
DIGEST_RETMAX=20
DIGEST_JOURNALS=N Engl J Med,Lancet,JAMA,BMJ,Ann Intern Med,JAMA Intern Med,Nat Med,Nature,Science,Cell

# Email output example. Replace with your own n8n SMTP credential.
DIGEST_FROM_EMAIL=digest@example.com
DIGEST_TO_EMAIL=reader@example.com

# LLM model placeholders. Configure credentials in n8n UI or use the standalone script values.
# Local deployment suggestions (LM Studio / Ollama / llama.cpp):
#   qwen/qwen3.5-9b          — Qwen3.5 9B dense, strong reasoning, 262K ctx
#   google/gemma-4-12b-it    — Gemma 4 12B dense, multimodal, 256K ctx
OPENAI_MODEL=qwen/qwen3.5-9b
# OpenRouter suggestion:
#   deepseek/deepseek-v4-flash       — $0.14/$0.28 per 1M, 1M ctx
#   deepseek/deepseek-v4-flash:free  — free tier with rate limits
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.5-9b

# Optional messaging outputs described in docs/output-options.md.
TELEGRAM_CHAT_ID=
WHATSAPP_TO=
